{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(make:*)",
      "Bash(uv:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./deploy/.env)",
      "Bash(git push:*)"
    ]
  }
}
