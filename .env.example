# KosPM - environment variables (template, placeholders only, no real secrets)
#
# Copy this file to ".env" at the REPOSITORY ROOT (next to CLAUDE.md and the Makefile):
#   PowerShell:  Copy-Item .env.example .env
#   cmd.exe:     copy .env.example .env
#   Git Bash:    cp .env.example .env
# Then replace every placeholder. Save the file as UTF-8 (a BOM from Notepad is tolerated).
# config/settings/base.py reads ".env" if it exists. Never commit ".env" (it is in .gitignore).
#
# Format rules (django-environ):
# - One KEY=value per line, no spaces around "=", no quotes needed.
# - Comments go on their OWN line, starting with "#". django-environ does NOT strip inline
#   comments: anything after the value (including " # ...") becomes part of the value.
# - Lines starting with "#" below are optional settings: remove the "# " to set them.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Optional. Settings module. Normally leave it unset: manage.py defaults to config.settings.dev,
# wsgi.py/asgi.py to config.settings.prod, and pytest uses config.settings.test.
# This file is read only AFTER the settings module has been chosen, so to switch modules set
# DJANGO_SETTINGS_MODULE in the shell or process environment, not here.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in dev and prod. Long random secret (sessions, CSRF, signed cleaner links).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-the-generated-secret-key

# Prod only. Comma-separated host names that Django serves, no spaces.
# Everything runs on one domain, and Caddy redirects www to it (ADR 0021).
# DJANGO_ALLOWED_HOSTS=ourbnb.gr

# Prod only. Comma-separated origins (with scheme) trusted for CSRF, no spaces.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ourbnb.gr

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required in dev and prod. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# - Local Windows PostgreSQL 18 service (see README.md, local setup): port 5432.
# - docker compose "db" service instead: port 5433, e.g.
#   postgres://kospm:CHANGE_ME@localhost:5433/kospm
# The password must be URL-safe: use only letters, digits, "-", "_", "." or "~", or
# percent-encode anything else (e.g. "@" -> %40, ":" -> %3A, "/" -> %2F, "#" -> %23).
# A URL-safe password can be generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_URL=postgres://kospm:CHANGE_ME@localhost:5432/kospm

# Optional. Name of the database that pytest creates and drops for integration/e2e tests
# (default: test_kospm). It uses the credentials of DATABASE_URL, so that role needs CREATEDB.
# KOSPM_TEST_DB=test_kospm

# ---------------------------------------------------------------------------
# Encryption of sensitive fields (used from Phase 1)
# ---------------------------------------------------------------------------

# Required in dev and prod. Fernet keys for encrypted fields (guest ID numbers, lockbox codes).
# Comma-separated, no spaces, NEWEST KEY FIRST. To rotate: put a new key first and keep the
# old keys after it until all data has been re-encrypted. Each key is 32 random bytes,
# urlsafe-base64 encoded. Generate one with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If every key is lost, the encrypted data cannot be recovered: keep a safe offline copy.
FERNET_KEYS=replace-me-with-a-generated-fernet-key

# ---------------------------------------------------------------------------
# docker compose "db" service only (not read by Django; default "kospm" for all three)
# Not needed when you use the local Windows PostgreSQL service. Inside docker compose the
# backend container builds its own DATABASE_URL from these values (host "db", port 5432).
# ---------------------------------------------------------------------------

# User created in the postgres:16 container.
# POSTGRES_USER=kospm

# Password of that user (URL-safe). If you run Django on the host against this container,
# use the same password in DATABASE_URL above, with port 5433.
# POSTGRES_PASSWORD=CHANGE_ME

# Database created in the postgres:16 container.
# POSTGRES_DB=kospm

# ---------------------------------------------------------------------------
# Owner portal and emails (ADR 0017)
# ---------------------------------------------------------------------------

# Optional. The name owners see in the portal and its emails (default KosPM).
# PORTAL_NAME=OurBnb

# Prod required, dev optional. Where the portal is reached; links in emails start with it.
# No trailing slash. Development default: http://localhost:8000
# PORTAL_BASE_URL=https://ourbnb.gr

# Optional. The sender of the portal's emails.
# DEFAULT_FROM_EMAIL=OurBnb <no-reply@ourbnb.gr>

# Prod required, dev optional. Who gets the requests for an estimate from the site's form.
# LEAD_NOTIFY_EMAIL=someone@example.com

# Prod only (required there). The SMTP server that delivers emails, as a URL, e.g.
#   smtp+tls://USER:PASSWORD@HOST:587   (STARTTLS)    smtp+ssl://USER:PASSWORD@HOST:465
# Percent-encode special characters of the password. Development prints emails to the console.
# EMAIL_URL=smtp+tls://USER:PASSWORD@smtp.example.com:587

# ---------------------------------------------------------------------------
# Reservations: iCal sync and admin alerts (Phase 3)
# ---------------------------------------------------------------------------

# Prod: set it. The admin's WhatsApp number, international format, for alerts (a failing calendar
# feed, a calendar event to review). Empty: alerts are only logged. Development prints them.
# ADMIN_WHATSAPP_NUMBER=+3069XXXXXXXX

# Optional. Minutes a calendar feed may keep failing before the admin is alerted (default 120).
# ICAL_ALERT_AFTER_MINUTES=120

# ---------------------------------------------------------------------------
# Listing text read by the Claude API (owner portal, Phase 2b). All optional.
# ---------------------------------------------------------------------------

# Anthropic API key (from console.anthropic.com). Owners paste the text of their listing and
# Claude fills in a draft of the property's profile, which they check before saving. Without a
# key the assistant is unavailable and owners fill in the profile by hand.
# Also set a monthly spend limit for the key in the Anthropic Console.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# The model and its effort (low, medium, high, xhigh, max). The defaults are shown.
# LISTING_EXTRACTOR_MODEL=claude-opus-5-5
# LISTING_EXTRACTOR_EFFORT=low

# ---------------------------------------------------------------------------
# Outbox worker (process_outbox, ADR 0004/0005). All optional: the defaults are shown.
# ---------------------------------------------------------------------------

# Which sender delivers WhatsApp messages. "console" prints them (development); WhatsApp
# arrives in Phase 6. Emails always go through Django's email backend (see EMAIL_URL).
# OUTBOX_SENDER=console

# Failed delivery attempts before a message is marked FAILED for the admin.
# OUTBOX_MAX_ATTEMPTS=5

# Wait after the first failed attempt, in seconds.
# OUTBOX_BASE_DELAY_SECONDS=60

# The wait is multiplied by this whole number after every further failure (1 = constant wait).
# OUTBOX_BACKOFF_FACTOR=2

# Longest wait between two attempts, in seconds (not shorter than OUTBOX_BASE_DELAY_SECONDS).
# OUTBOX_MAX_DELAY_SECONDS=3600

# Messages handled per worker run (the scheduler runs the worker every minute).
# OUTBOX_BATCH_SIZE=100
